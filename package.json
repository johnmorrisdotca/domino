{
  "name": "@johnmorrisdotca/domino",
  "version": "1.1.0",
  "description": "Dominoes for JavaScript and TypeScript: double-nine, double-twelve and double-fifteen sets, and the full rules of Mexican Train for two to eight players, with a computer player, seeded deals that replay exactly, a compact saved-game format, the words of the table in English and Japanese, tile sounds and a command line. Zero dependencies.",
  "keywords": [
    "dominoes",
    "domino",
    "mexican-train",
    "mexican-train-dominoes",
    "train-dominoes",
    "double-twelve",
    "double-nine",
    "double-fifteen",
    "domino-game",
    "tile-game",
    "board-game",
    "game-engine",
    "game-rules",
    "rules-engine",
    "computer-player",
    "ai-player",
    "bot",
    "seeded",
    "seeded-random",
    "deterministic",
    "replay",
    "save-game",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "node",
    "party-game",
    "family-game",
    "itsutsu",
    "mexican-dominoes",
    "domino-tiles",
    "tabletop",
    "cli",
    "command-line",
    "japanese",
    "i18n",
    "sounds",
    "web-audio",
    "esm",
    "json",
    "game-state",
    "pure-functions",
    "turn-based",
    "hub",
    "boneyard",
    "pips"
  ],
  "homepage": "https://github.com/johnmorrisdotca/domino#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/domino.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/domino/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tile-sounds": {
      "types": "./dist/tile-sounds.d.ts",
      "import": "./dist/tile-sounds.js",
      "default": "./dist/tile-sounds.js"
    },
    "./sounds": {
      "types": "./dist/sounds.d.ts",
      "import": "./dist/sounds.js",
      "default": "./dist/sounds.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "docs/credits.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:cli": "pnpm build && node scripts/check-cli.mjs",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "docs:api": "node scripts/api-write.mjs",
    "docs:make": "node scripts/docs.mjs",
    "sounds": "node scripts/sounds.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build",
    "site": "pnpm build && node scripts/site.mjs",
    "pictures": "pnpm site && node scripts/readme-pictures.mjs",
    "test:demo": "pnpm site && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "bin": {
    "domino": "bin/domino.mjs"
  }
}
